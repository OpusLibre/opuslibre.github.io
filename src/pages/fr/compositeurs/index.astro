---
import Base from "../../../layouts/Base.astro";
import { ENTRIES, COMPOSERS, countBy, plural } from "../../../lib/catalogue";

const byComposer = countBy((e) => e.composer.id);
const composers = Object.values(COMPOSERS).filter((c) => byComposer[c.id]).sort((a, b) => a.name.localeCompare(b.name, "fr"));
---
<Base title="Compositeurs" section="compositeurs">
  <h1>Compositeurs</h1>
  <p class="lead">{plural(composers.length, "compositeur")} · {plural(ENTRIES.length, "partition")}</p>
  <ul class="index">
    {composers.map((c) => (
      <li><a href={`/fr/compositeurs/${c.id}/`}><strong>{c.name}</strong><span>{c.dates ?? ""}</span><span>{plural(byComposer[c.id]!, "partition")}</span></a></li>
    ))}
  </ul>
</Base>
<style>
  h1 { font-size: clamp(2rem, 4vw, 2.8rem); padding-top: 2.5rem; }
  .lead { color: var(--muted); margin: 0.6rem 0 2rem; }
  .index { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--ink); }
  .index a { display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  @media (min-width: 760px) { .index a { grid-template-columns: 1fr 10rem 8rem; } }
  .index strong { font: 400 1.2rem var(--serif); }
  .index span { color: var(--muted); font-size: 0.9rem; }
  .index a:hover strong { text-decoration: underline; }
</style>
