---
interface Props { id: string; value?: string; large?: boolean; autofocus?: boolean }
const { id, value = "", large = false, autofocus = false } = Astro.props;
---
<form class:list={["search-box", { large }]} action="/fr/partitions/" method="get" role="search">
  <label for={id} class="visually-hidden">Rechercher une partition</label>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <input id={id} name="q" type="search" value={value} placeholder="Titre, compositeur, BWV 846…" autocomplete="off" enterkeyhint="search" autofocus={autofocus} data-search-input />
  <button type="submit"><span class="label">Rechercher</span><span class="arrow" aria-hidden="true">→</span></button>
</form>
<style>
  .search-box { display: flex; align-items: center; gap: 0.6rem; border-bottom: 1px solid var(--ink); padding: 0.35rem 0; }
  .search-box svg { flex: none; color: var(--muted); }
  .search-box input { flex: 1; min-width: 0; border: 0; background: none; font: inherit; font-size: 0.95rem; padding: 0.4rem 0; color: var(--ink); }
  .search-box input:focus { outline: none; }
  .search-box:focus-within { border-bottom-width: 2px; margin-bottom: -1px; }
  .search-box button { flex: none; border: 1px solid var(--ink); background: var(--ink); color: #fff; font: 600 0.85rem var(--sans); padding: 0.5rem 0.9rem; cursor: pointer; }
  .search-box .arrow { display: none; }
  @media (max-width: 559px) {
    .search-box .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .search-box .arrow { display: inline; font-size: 1.1rem; }
  }
  .search-box.large input { font-size: 1.1rem; padding: 0.6rem 0; }
  .search-box.large button { padding: 0.7rem 1.2rem; }
</style>
