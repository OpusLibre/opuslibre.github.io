{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musicalis",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "observability": { "enabled": true },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/", "/p/*"] },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "musicalis-files" }]
}
